<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="8dp"
    tools:context=".view.profile.ProfileFragment">

    <!-- Username and Logout Row -->
    <LinearLayout
        android:id="@+id/usernameRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="32dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/textViewProfileUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="24sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/buttonLogoutIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_logout"
            android:contentDescription="Logout"/>
    </LinearLayout>

    <!-- Profile photo, then description and friends below -->
    <LinearLayout
        android:id="@+id/profileHeaderColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/usernameRow"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:id="@+id/imageProfileAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_account_circle_black_24dp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerCrop"
            android:contentDescription="Profile avatar"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textViewProfileBio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4th Year computer Engineering student enjoying hiking and dawe;wek;k ;asdl ka;dk;asldk; askd ;alskd;laskd"
            android:textSize="15sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#222"
            android:gravity="start"/>
        <TextView
            android:id="@+id/textViewProfileFriends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 Friends"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:gravity="start"/>
    </LinearLayout>

    <!-- Tabs for My Trails / Saved Trails -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutTrails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/purple_500"
        app:tabSelectedTextColor="@color/purple_500"
        app:tabTextColor="#888"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabRippleColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/profileHeaderColumn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <!-- Content Frame for tab switching -->
    <FrameLayout
        android:id="@+id/frameLayoutTrailsContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutTrails"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
