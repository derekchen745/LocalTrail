<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF6FF"
    android:paddingTop="8dp">

    <!-- Sort and Filter Row -->
    <LinearLayout
        android:id="@+id/sortLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/textSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2195 Sort"
            android:textColor="@color/purple_500"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_sort"
            android:drawablePadding="4dp"
            android:paddingEnd="16dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E0E0E0"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTagFilter"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            app:icon="@drawable/ic_filter"
            app:iconTint="#1D1B20"
            app:strokeColor="#CAC4D0"
            app:cornerRadius="20dp"/>
        <ImageButton
            android:id="@+id/buttonListGridToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_list"
            android:contentDescription="Toggle list/grid" />
    </LinearLayout>

    <TextView
        android:id="@+id/textSavedTrailsPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Saved Trails will appear here."
        android:textSize="18sp"
        android:textColor="#888"
        android:gravity="center"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTrails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_trail"/>
</LinearLayout>
