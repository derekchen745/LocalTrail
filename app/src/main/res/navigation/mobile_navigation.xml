<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.localtrail.view.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">

        <!-- ① Action from Home → Recording -->
        <action
            android:id="@+id/action_navigation_home_to_trailRecordingFragment"
            app:destination="@id/trailRecordingFragment"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.localtrail.view.feed.FeedFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_feed" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.localtrail.view.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.localtrail.view.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ② Your new recording screen -->
    <fragment
        android:id="@+id/trailRecordingFragment"
        android:name="com.example.localtrail.view.trail.TrailRecordingFragment"
        android:label="Record Trail"
        tools:layout="@layout/fragment_trail_recording"/>
</navigation>
